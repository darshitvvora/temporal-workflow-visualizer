{
  "name": "temporal-workflow-visualizer",
  "displayName": "Temporal Workflow Visualizer",
  "description": "Visualize Temporal workflows as interactive Mermaid flowcharts with click-to-navigate",
  "version": "0.1.0",
  "publisher": "darshitvvora",
  "repository": {
    "type": "git",
    "url": "https://github.com/darshitvvora/temporal-workflow-visualizer.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [
    "onLanguage:go",
    "onLanguage:java",
    "onLanguage:python",
    "onLanguage:typescript",
    "onLanguage:php",
    "onLanguage:csharp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "temporalVisualizer.showDiagram",
        "title": "Temporal: Visualize Workflow",
        "icon": "$(type-hierarchy)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "temporalVisualizer.showDiagram",
          "when": "resourceExtname =~ /\\.(go|java|py|ts|php|cs)$/",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "temporalVisualizer.showDiagram",
          "when": "resourceExtname =~ /\\.(go|java|py|ts|php|cs)$/"
        }
      ],
      "commandPalette": [
        {
          "command": "temporalVisualizer.showDiagram",
          "when": "editorIsOpen"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --out dist/",
    "test:python": "tsc -p tsconfig.test.json && node out/test/python/recognizer.smoke.js && node out/test/python/cfg.smoke.js && node out/test/python/parser.smoke.js && node out/test/python/mermaid.smoke.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "mermaid": "^11.14.0",
    "web-tree-sitter": "^0.26.8"
  }
}
